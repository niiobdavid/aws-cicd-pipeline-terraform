# Copy this file to terraform.tfvars and change the values you need.

aws_region    = "eu-central-1"
your_name     = "nii"
github_repo   = "niiobdavid/nextwork-web-project"   # owner/repo of the repo with buildspec.yml + appspec.yml
github_branch = "master"

